# Copy to .env and fill in. .env is git-ignored.
# OpenAI-compatible endpoint used by rubric_parsing and backend /review.

# Local Ollama (free, fully local — fits Stranger Mode's privacy rules):
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1
LLM_API_KEY=ollama

# Hosted example (do not commit real keys):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...
